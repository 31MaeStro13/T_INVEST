# ==========================================
# Telegram Bot Configuration
# ==========================================
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
ADMIN_IDS=123456789
BACKEND_API_URL=http://backend:8000

# Optional proxy for Telegram Bot (e.g. SOCKS5 / HTTP)
# TELEGRAM_PROXY=http://127.0.0.1:10808

# ==========================================
# Django Backend & Security
# ==========================================
DJANGO_SECRET_KEY=django-insecure-generate-unique-key-in-prod-32chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend,bot

# Fernet 32-byte Base64 key for encrypting user tokens at rest
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=generate_fernet_key_here_base64_32bytes=

# Zero-Knowledge HMAC salt for user hashes
USER_HASH_SALT=change_this_to_a_random_string_in_production

# ==========================================
# T-Bank Invest API
# ==========================================
T_BANK_READ_ONLY_INVEST_TOKEN=your_t_bank_read_only_token_here

# ==========================================
# PostgreSQL
# ==========================================
# Пароль для PostgreSQL (используется docker-compose.yml)
POSTGRES_PASSWORD=t_invest_secret
# DATABASE_URL автоматически задаётся в docker-compose через environment:
# Для локальной разработки без Docker — раскомментируйте:
# DATABASE_URL=postgres://t_invest_user:t_invest_secret@localhost:5432/t_invest_db

# ==========================================
# Redis & Celery Workers
# ==========================================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1

# ==========================================
# Gemini AI (AI-аудитор портфеля)
# ==========================================
GEMINI_API=your_gemini_api_key_here
# Прокси для Gemini API (если нужен):
# GEMINI_PROXY=http://127.0.0.1:10808

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=INFO
LOG_FORMAT="[%(asctime)s] #%(levelname)-8s %(filename)s:%(lineno)d - %(name)s - %(message)s"
